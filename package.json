{
  "name": "harness-accountant",
  "version": "0.2.0",
  "private": true,
  "description": "DeepSeek balance and spend accounting for the DSH Web GUI: a sidebar card showing today's spend, the account's currency, and whether the current hour is billed at the peak or off-peak rate, plus a Settings breakdown for 1 day / 7 days / 1 month.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/its0din-ai/harness-accountant.git"
  },
  "homepage": "https://github.com/its0din-ai/harness-accountant#readme",
  "bugs": {
    "url": "https://github.com/its0din-ai/harness-accountant/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "THREAT.md"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
